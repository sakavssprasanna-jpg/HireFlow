# HireFlow Environment Configuration Example
PROJECT_NAME="HireFlow"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite default; can point to PostgreSQL)
DATABASE_URL="sqlite:///./hireflow.db"

# AI Provider Configuration
# Supported options: OFFLINE_FALLBACK | LIVE_GEMINI | LIVE_GROQ
DEFAULT_AI_MODE="OFFLINE_FALLBACK"

# Optional Cloud API Keys (Leave blank to operate in guaranteed 100% offline fallback mode)
GEMINI_API_KEY=""
GROQ_API_KEY=""

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
